spring.application.name=chartmania
spring.thymeleaf.cache=false
# Simplify console logs
logging.pattern.console=%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n%throwable{short}

# Hide noisy frameworks
logging.level.org.springframework.web=ERROR
logging.level.org.thymeleaf=ERROR
logging.level.org.apache.catalina=ERROR

# Optional: show root cause first
logging.exception-conversion-word=%rEx

#Browser error stack trace
server.error.include-message=always
server.error.include-binding-errors=always
server.error.include-stacktrace=always
server.error.include-exception=true

# Chart uploads
chart.upload.directory=${CHART_UPLOAD_DIRECTORY:/uploads/charts}

# MariaDB connection
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mariadb://localhost:3306/chartmania}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:root}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}

# ORM / JPA configuration
spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.jpa.show-sql=${SPRING_JPA_SHOW_SQL:true}
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MariaDBDialect

# Security
secure.cookie=${SECURE_COOKIE:false}

# JWT
jwt.secret=${JWT_SECRET:dev-secret-change-me}
jwt.issuer=${JWT_ISSUER:chartmania-api}
jwt.exp-minutes=${JWT_EXP_MINUTES:80}
jwt.refresh.token.exp-minutes=${JWT_REFRESH_TOKEN_EXP_MINUTES:14400}

# CORS
allowed.origin=${ALLOWED_ORIGIN:http://localhost:5173}


#Cookie
secure.cookie=false


#JWT
jwt.secret=your_secret_key
jwt.issuer=chartmania-api
jwt.exp-minutes=15
jwt.refresh.token.exp-minutes=14400


allowed.origin=http://your_origin